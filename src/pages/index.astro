---
import LabLayout from '../layouts/LabLayout.astro';
---

<LabLayout>
  <main class="core-lab" data-core-lab data-language="es">
    <div class="ambient-grid" aria-hidden="true"></div>
    <section class="lab-panel" aria-label="Core Asset Lab session">
      <div class="brand-row"><span>CORE ASSET LAB / 001</span><div class="top-actions"><i>LOCAL LAB</i><div class="language" aria-label="Language"><button type="button" data-lab-language="es">ES</button><button type="button" data-lab-language="en">EN</button></div></div></div>
      <div class="session-head"><div><small>SESSION / INPUT</small><h1>Core Asset Lab</h1></div><span class="local-badge">LOCAL</span></div>
      <p class="session-copy" data-es="Carga el asset y usa el inspector para transformar, iluminar, calibrar y probar su presentación." data-en="Load the asset and use the inspector to transform, light, calibrate and test its presentation.">Carga el asset y usa el inspector para transformar, iluminar, calibrar y probar su presentación.</p>
      <div class="asset-row"><label class="upload"><span data-es="CARGAR GLB / GLTF" data-en="LOAD GLB / GLTF">CARGAR GLB / GLTF</span><input data-core-file type="file" accept=".glb,.gltf,model/gltf-binary,model/gltf+json" /></label><div class="status" data-core-status>ESPERANDO MODELO LOCAL</div></div>
      <div class="session-note"><i></i><span data-es="Procesamiento local · el modelo no se carga a ningún servidor." data-en="Local processing · the model is not uploaded to any server.">Procesamiento local · el modelo no se carga a ningún servidor.</span></div>
    </section>
    <div class="stage" data-core-drop>
      <canvas data-core-canvas aria-label="Interactive 3D model preview"></canvas>
      <div class="workflow" aria-label="Lab workflow"><span class="is-active">01 <b>LOAD</b></span><i>›</i><span>02 <b>CALIBRATE</b></span><i>›</i><span>03 <b>COMPARE</b></span></div>
      <div class="viewport-stats" data-viewport-stats aria-live="polite"><span>MODEL / WAITING</span><span>WEBGL / ACTIVE</span></div><div class="viewport-live"><i></i> REAL-TIME VIEW</div>
      <div class="viewport-help" data-es="ARRASTRA PARA ROTAR · BOTÓN DERECHO PARA MOVER · RUEDA PARA ZOOM" data-en="DRAG TO ROTATE · RIGHT CLICK TO PAN · SCROLL TO ZOOM">ARRASTRA PARA ROTAR · BOTÓN DERECHO PARA MOVER · RUEDA PARA ZOOM</div>
      <div class="stage-fx" aria-hidden="true"><div class="rail rail-bottom"><span>CORE ASSET LAB</span><b>LOAD</b><b>INSPECT</b><b>CALIBRATE</b><b>INTEGRATE</b></div></div><div class="drop-hint" data-drop-hint><span data-es="ARRASTRA TU MODELO AQUÍ" data-en="DROP YOUR MODEL HERE">ARRASTRA TU MODELO AQUÍ</span><br/><small>GLB / GLTF · LOCAL SESSION</small></div><div class="hud hud-a">LAB / 001</div>
    </div>
  </main>
  <script src="../scripts/core-asset-lab.ts"></script><script src="../scripts/core-lab-interface.ts"></script><script src="../scripts/core-lab-workspace.ts"></script><script src="../scripts/core-lab-controls.ts"></script><script src="../scripts/core-lab-tools.ts"></script>
</LabLayout>
<style>
:global(body){margin:0;background:#020304;color:#f4f5f7;overflow:hidden}.core-lab{position:relative;min-height:100vh;background:#020304;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;isolation:isolate}.ambient-grid{position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(circle at 62% 48%,rgba(103,0,15,.12),transparent 34%),radial-gradient(circle at 42% 58%,rgba(87,220,241,.035),transparent 30%),linear-gradient(180deg,#030405,#010203)}.lab-panel{position:absolute;z-index:6;left:1rem;top:1rem;width:min(300px,calc(100vw - 2rem));padding:.85rem .9rem .8rem;border:1px solid rgba(255,255,255,.085);background:linear-gradient(180deg,rgba(5,7,9,.94),rgba(3,4,5,.84));backdrop-filter:blur(12px);box-shadow:0 18px 55px rgba(0,0,0,.32)}.brand-row,.top-actions,.language,.session-head,.session-note{display:flex;align-items:center}.brand-row{justify-content:space-between;font-size:.52rem;letter-spacing:.14em;color:#9aa1aa}.top-actions{gap:.5rem}.brand-row i{font-style:normal;color:#ff4863}.language{border:1px solid rgba(255,255,255,.1)}.language button{border:0;background:transparent;color:#626a73;padding:.22rem .3rem;font:inherit;font-size:.48rem;cursor:pointer}.language button.is-active{background:#ff3148;color:#fff}.session-head{justify-content:space-between;gap:.8rem;margin-top:.65rem}.session-head small{font-size:.47rem;letter-spacing:.14em;color:#5f6872}.session-head h1{font-family:Arial,Helvetica,sans-serif;font-size:1.55rem;line-height:1;letter-spacing:-.045em;margin:.16rem 0 0}.local-badge{border:1px solid rgba(100,230,255,.28);padding:.28rem .38rem;color:#64e6ff;font-size:.48rem;letter-spacing:.12em}.session-copy{margin:.55rem 0 0;color:#8e969f;font-size:.58rem;line-height:1.45}.asset-row{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.6rem;align-items:center;margin-top:.7rem}.upload{padding:.58rem .68rem;border:1px solid rgba(255,49,72,.42);background:rgba(255,25,55,.035);font-size:.54rem;letter-spacing:.07em;cursor:pointer}.upload input{display:none}.status{font-size:.46rem;line-height:1.3;color:#ff6376;overflow:hidden;overflow-wrap:anywhere}.session-note{gap:.42rem;margin-top:.6rem;padding-top:.55rem;border-top:1px solid rgba(255,255,255,.06);font-size:.47rem;line-height:1.35;color:#69727c}.session-note>i{width:5px;height:5px;flex:0 0 auto;border-radius:50%;background:#64e6ff;box-shadow:0 0 10px rgba(100,230,255,.55)}.stage{position:absolute;inset:0;overflow:hidden;z-index:1}.stage canvas{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:1}.stage::before{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.012),transparent 18%,transparent 82%,rgba(255,255,255,.008))}.stage::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:radial-gradient(circle at 55% 52%,transparent 0 34%,rgba(0,0,0,.06) 54%,rgba(0,0,0,.58) 100%)}.workflow{position:absolute;z-index:5;top:1.25rem;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:1rem;color:#53616d;font-size:.55rem;letter-spacing:.12em}.workflow span{padding:.4rem .2rem;border-bottom:2px solid transparent}.workflow span.is-active{color:#fff;border-color:#ff3148}.workflow span.is-active b{color:#ff536a}.workflow i{font-style:normal;color:#ff3148}.viewport-stats{position:absolute;z-index:5;left:calc(min(300px,calc(100vw - 2rem)) + 3rem);top:4.3rem;display:grid;gap:.28rem;padding-left:.65rem;border-left:1px solid rgba(100,230,255,.35);font-size:.47rem;letter-spacing:.08em;color:#71808c}.viewport-stats span:first-child{color:#cbd2d8}.viewport-live{position:absolute;z-index:5;right:2rem;top:4.3rem;color:#cbd2d8;font-size:.47rem;letter-spacing:.12em}.viewport-live i{display:inline-block;width:5px;height:5px;margin-right:.35rem;border-radius:50%;background:#ff3148;box-shadow:0 0 9px #ff3148}.viewport-help{position:absolute;z-index:5;left:50%;bottom:1.3rem;transform:translateX(-50%);white-space:nowrap;color:#60707c;font-size:.47rem;letter-spacing:.1em}.stage-fx{position:absolute;inset:0;z-index:3;pointer-events:none;overflow:hidden}.rail{position:absolute;display:flex;gap:.65rem;font-size:.48rem;color:#4d555e;white-space:nowrap}.rail span{color:#c9cdd2}.rail-bottom{right:3.5%;bottom:3rem}.drop-hint{position:absolute;z-index:4;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center;font-size:.69rem;letter-spacing:.2em;color:rgba(255,255,255,.18);pointer-events:none}.drop-hint small{font-size:.46rem;color:rgba(100,230,255,.42)}.stage.has-model .drop-hint{opacity:0}.hud{position:absolute;z-index:4;font-size:.54rem;color:rgba(255,255,255,.24)}.hud-a{right:2rem;top:2rem}@media(max-width:1100px){.workflow{top:.75rem}.viewport-stats{display:none}.viewport-live{top:3rem}.viewport-help{bottom:.75rem}.rail-bottom{bottom:2.5rem}}@media(max-width:820px){:global(body){overflow:auto}.lab-panel{position:relative;left:auto;top:auto;margin:1rem;width:auto}.stage{position:relative;min-height:68vh}.workflow{display:none}.viewport-live{right:1rem}.viewport-help{font-size:.4rem;white-space:normal;width:80%;text-align:center}.rail{display:none}.drop-hint{left:50%}}@media(prefers-reduced-motion:reduce){.stage-fx{transition:none}}
</style>
